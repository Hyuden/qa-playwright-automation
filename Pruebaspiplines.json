              "// 1. Validar que la llamada fue exitosa (Status 200)\r",
              "pm.test(\"Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Validar que el tiempo de respuesta sea óptimo\r",
              "pm.test(\"Tiempo de respuesta menor a 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "// 3. Validar el contenido y tipos de datos del cuerpo (Body)\r",
              "pm.test(\"El post tiene id 1 y estructura correcta\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data.id).to.eql(1);\r",
              "    pm.expect(data.title).to.be.a(\"string\");\r",
              "    pm.expect(data.userId).to.be.a(\"number\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
